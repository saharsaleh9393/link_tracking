DATABASE_URL=postgresql+psycopg://tracker:tracker_local_only@127.0.0.1:5432/tracker
# Generate each key independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=replace-with-at-least-32-random-characters
REPORT_API_KEY=replace-with-a-different-32-character-key
VISITOR_HMAC_KEY=replace-with-an-independent-random-key
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Next.js settings and the separate dashboard login live in web/.env.local.
# Optional comma-separated exact destination hosts. Empty permits public HTTP(S) destinations.
DESTINATION_ALLOWED_HOSTS=
LINK_CACHE_TTL_SECONDS=2
LINK_CACHE_MAX_SIZE=10000
RAW_RETENTION_DAYS=90
WORKER_INTERVAL_SECONDS=60
# Only actual reverse-proxy network ranges; empty means ignore forwarded headers.
TRUSTED_PROXY_CIDRS=
# Set e.g. CF-IPCountry only if your trusted edge overwrites it.
COUNTRY_HEADER=
# Install a local MMDB with: python scripts/install_geoip.py
GEOIP_DATABASE_PATH=.local/geoip/country.mmdb
