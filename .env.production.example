# Documentation only. Run deploy/init_deployment.py --mode production for independent secrets.
# Replace every example domain/release/email before starting; real env files are ignored.
COMPOSE_PROJECT_NAME=linkspace-prod
APP_ENV=production
RELEASE_TAG=replace-with-git-sha
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
DASHBOARD_ORIGIN=https://panel.example.com
PUBLIC_BASE_URL=https://go.example.com
DASHBOARD_SITE=https://panel.example.com
# Caddy site addresses, comma separated. All require prior DNS/TLS/proxy setup.
TRACKING_SITES=https://go.example.com
DASHBOARD_TRACKING_PATHS="/r/* /go/*"
HTTP_ALLOWED_HOSTS=api,127.0.0.1,localhost,panel.example.com,go.example.com
DASHBOARD_SECURE_COOKIES=true
ACME_EMAIL=replace-with-your-email@example.invalid
# Add exact origins only AFTER configuring and testing routing.
LINKSPACE_ROUTED_ORIGINS=
LINKSPACE_ROOT_ORIGINS=
EDGE_SUBNET=172.30.50.0/24
EDGE_DYNAMIC_RANGE=172.30.50.128/25
PROXY_IP=172.30.50.2
POSTGRES_DB=linkspace
SECRETS_DIRECTORY=.local/deployment/linkspace-prod/secrets
GEOIP_DIRECTORY=./.local/geoip
BACKUP_DIRECTORY=./.local/backups
BACKUP_UID=1000
BACKUP_GID=1000
RAW_RETENTION_DAYS=90
WORKER_INTERVAL_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DASHBOARD_LOGIN_CLIENT_LIMIT=10
DASHBOARD_LOGIN_ACCOUNT_LIMIT=100
DASHBOARD_LOGIN_WINDOW_SECONDS=60
