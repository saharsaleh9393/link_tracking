{
    admin off
    auto_https off
    log default {
        output stdout
        format json
        exclude http.log.access http.log.error
    }
}
import /etc/caddy/routes.caddy
{$DASHBOARD_SITE} {
    import dashboard web:3000
}
http://panel.localhost:8082 {
    import dashboard web2:3000
}
{$TRACKING_SITES} {
    import tracking
}
:8080 {
    respond /healthz 200
    respond 404
}
:80 {
    respond 404
}
