# FastAPI connection and keys are inherited server-side from ../.env.
TRACKER_API_URL=http://127.0.0.1:8000
# Set this to the address visitors will open; it is intentionally public.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Generate independent values with npm run init-env; never commit .env.local.
DASHBOARD_PASSWORD=replace-with-a-strong-local-login-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set true only when the dashboard is served over HTTPS.
DASHBOARD_SECURE_COOKIES=false
